 {
  "id": "in_alarm",
  "type": "mqtt in",
  "name": "bms/pack01/alarms",
  "topic": "bms/pack01/alarms",
  "qos": "1",
  "datatype": "json",
  "broker": "mqtt_broker",
  "wires": [
   [
    "fn_alarm"
   ]
  ],
  "z": "f_bms",
  "x": 200,
  "y": 480
 },
 {
  "id": "fn_alarm",
  "type": "function",
  "name": "alarm list + toast",
  "outputs": 2,
  "func": "\nconst a = msg.payload;\nlet act = flow.get(\"active\") || {};\nlet log = flow.get(\"log\") || [];\nconst key = a.code + \":\" + a.level;\nif (a.active) act[key] = a; else delete act[key];\nlog.unshift(a); log = log.slice(0, 50);\nflow.set(\"active\", act); flow.set(\"log\", log);\nconst toast = a.active && a.level === \"FAULT\"\n  ? {topic: \"BMS FAULT\", payload: a.text + \" at t = \" + a.t.toFixed(1) + \" s\"} : null;\nreturn [{payload: {active: Object.values(act), log: log}}, toast];",
  "wires": [
   [
    "ui_alarms"
   ],
   [
    "ui_toast"
   ]
  ],
  "z": "f_bms",
  "x": 420,
  "y": 480
 },
 {
  "id": "ui_alarms",
  "type": "ui_template",
  "name": "alarm table",
  "group": "g_alarm",
  "order": 1,
  "width": "12",
  "height": "8",
  "format": "\n<div>\n  <h4 style=\"margin:4px 0\">Active alarms</h4>\n  <div ng-if=\"!msg.payload.active.length\" style=\"color:#3c3\">No active alarms</div>\n  <div ng-repeat=\"a in msg.payload.active\" ng-style=\"{background: a.level=='FAULT' ? '#c33' : '#d98b00', color:'#fff', padding:'4px 8px', margin:'2px 0', 'border-radius':'4px'}\">\n    {{a.level}} - {{a.text}} (since t = {{a.t | number:1}} s, source {{a.source}})</div>\n  <h4 style=\"margin:10px 0 4px\">Alarm log</h4>\n  <table style=\"width:100%; font-size:12px\">\n    <tr><th align=\"left\">t (s)</th><th align=\"left\">Level</th><th align=\"left\">Alarm</th><th align=\"left\">Status</th></tr>\n    <tr ng-repeat=\"a in msg.payload.log\"><td>{{a.t | number:1}}</td><td>{{a.level}}</td><td>{{a.text}}</td>\n        <td>{{a.active ? 'RAISED' : 'cleared'}}</td></tr>\n  </table>\n</div>",
  "storeOutMessages": true,
  "fwdInMessages": true,
  "templateScope": "local",
  "z": "f_bms",
  "x": 640,
  "y": 480,
  "wires": []
 },
 {
  "id": "ui_toast",
