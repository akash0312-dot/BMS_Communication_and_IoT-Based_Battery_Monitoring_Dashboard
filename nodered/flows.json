  "id": "in_tel",
  "type": "mqtt in",
  "name": "bms/pack01/telemetry",
  "topic": "bms/pack01/telemetry",
  "qos": "0",
  "datatype": "json",
  "broker": "mqtt_broker",
  "wires": [
   [
    "fn_split"
   ]
  ],
  "z": "f_bms",
  "x": 200,
  "y": 40
 },
 {
  "id": "fn_split",
  "type": "function",
  "name": "split telemetry",
  "outputs": 8,
  "func": "\nconst p = msg.payload;\nconst dv = p.vmax && p.vmin ? Math.round((p.vmax - p.vmin) * 1000) : null;\nreturn [\n  {payload: p.soc}, {payload: p.pack_v}, {payload: p.pack_i}, {payload: p.tmax},\n  [{topic: \"Voltage (V)\", payload: p.pack_v}, {topic: \"Current (A)\", payload: p.pack_i}],\n  p.temps.map((t, k) => ({topic: \"T\" + (k + 1), payload: t})),\n  {payload: p.state + \" | contactor \" + p.contactor + \" | t = \" + p.t.toFixed(0) + \" s\"},\n  {payload: \"min \" + p.vmin + \" V (C\" + p.vmin_idx + \")  max \" + p.vmax + \" V (C\" + p.vmax_idx + \")  spread \" + dv + \" mV\"}\n];",
  "wires": [
   [
    "ui_soc"
   ],
   [
    "ui_v"
   ],
   [
    "ui_i"
   ],
   [
    "ui_t"
   ],
   [
    "ui_chart_vi"
   ],
   [
    "ui_chart_t"
   ],
   [
    "ui_state"
   ],
   [
    "ui_cells"
   ]
  ],
  "z": "f_bms",
  "x": 420,
  "y": 40
 },
